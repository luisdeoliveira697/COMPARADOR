rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cambia TU_CORREO@gmail.com por el correo de Google del administrador.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'TU_CORREO@gmail.com';
    }
    function isMember() {
      return request.auth != null && (isAdmin() ||
        request.auth.token.email in get(/databases/$(database)/documents/access/members).data.emails);
    }
    // Lista de usuarios autorizados: todos la leen, solo el administrador la cambia.
    match /access/members {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    // Catálogos, condiciones, cruces y pedidos de la ferretería.
    match /ws/{doc} {
      allow read, write: if isMember();
    }
  }
}
